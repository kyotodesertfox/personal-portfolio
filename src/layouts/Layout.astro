---
/*
  THE FRONTMATTER BLOCK (between the --- fences)
  This is the biggest visual difference from React. In React, you put
  component logic inside the function body. In Astro, you put it up here.

  Code in this block runs ONCE at build time on the server - never in the
  browser. That means no useState, no useEffect, no event listeners here.
  Think of it as the "setup" step before the HTML is written.

  Props work the same way as React though:
    React:  const Layout = ({ title, description }) => { ... }
    Astro:  const { title, description } = Astro.props;
*/

import '../styles/global.css';

// Astro.props is how you receive props - same concept as React props,
// just accessed differently. TypeScript interface is optional but helpful.
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Websites, networking, and IT support. Independent - one person, no agency.',
  image = '/og-image.png',
} = Astro.props;

const siteName    = 'IT & Web Guy';
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://jax-web-services.netlify.app');
const imageURL      = new URL(image, Astro.site ?? 'https://jax-web-services.netlify.app');
---

<!--
  TEMPLATE SECTION (everything below the closing ---)
  This is plain HTML - not JSX. A few differences from React:
    - class="..." not className="..."
    - No need to wrap everything in a single parent element
    - <head> and <html> tags live here, not in a separate index.html
-->

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />

    <!--
      {curly braces} work the same as in JSX - expressions, variables, etc.
      The difference: this is evaluated at BUILD TIME, not at runtime in the browser.
    -->
    <title>{title}</title>
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-N7YKK2BLKQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-N7YKK2BLKQ');
    </script>
  </head>

  <body class="bg-white text-zinc-900 antialiased">

    <!--
      Scroll progress. Scales on the X axis from the left edge rather than
      animating width, so it stays on the compositor and never triggers
      layout. Sits above the fixed footer (z-40) and the gallery lightbox
      (z-50).
    -->
    <div
      id="scroll-progress"
      class="fixed top-0 left-0 right-0 h-1 bg-amber-400 z-[60] origin-left"
      style="transform: scaleX(0)"
      aria-hidden="true"
    ></div>

    <script>
      const bar = document.getElementById('scroll-progress');

      if (bar) {
        const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        let target  = 0;
        let current = 0;
        let frame   = null;

        const measure = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          target = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
        };

        const paint = (value) => {
          bar.style.transform = `scaleX(${value})`;
        };

        // Eases toward the target instead of snapping, which is what the
        // spring in the original was doing.
        const tick = () => {
          current += (target - current) * 0.15;

          if (Math.abs(target - current) < 0.0005) {
            current = target;
            frame = null;
            paint(current);
            return;
          }

          paint(current);
          frame = requestAnimationFrame(tick);
        };

        const onScroll = () => {
          measure();
          if (!smooth) { current = target; paint(current); return; }
          if (frame === null) frame = requestAnimationFrame(tick);
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        onScroll();
      }
    </script>

    <!--
      <slot /> is Astro's equivalent of {children} in React.
      Whatever you put between <Layout>...</Layout> tags in a page
      gets rendered here. Exact same concept, different keyword.
    -->
    <slot />

  </body>
</html>
