---
import Layout from '../layouts/Layout.astro';
import OrderModal from '../components/OrderModal.jsx';
import ProjectGallery from '../components/ProjectGallery.jsx';
---

<Layout title="IT & Web Guy">

  <main class="pb-16">

    <!--
      Netlify detects forms at BUILD TIME by scanning static HTML.
      Since our form lives inside a React component, Netlify never sees it.
      This hidden form is the workaround - same field names, same form-name,
      invisible to the user but visible to Netlify's build crawler.
    -->
    <form name="project-intake" netlify netlify-honeypot="bot-field" data-netlify="true" hidden>
      <input type="hidden" name="form-name" value="project-intake" />
      <input name="bot-field" />
      <!-- FUTURE: auto-capture connected wallet address via useAccount() when submitting -->
      <!-- <input name="wallet" /> -->
      <input name="inquiry-type" />
      <input name="name" />
      <input name="email" />
      <input name="phone" />
      <input name="purpose" />
      <input name="url" />
      <textarea name="comments"></textarea>
      <input type="file" name="file" />
    </form>

    <!-- =====================================================================
         HERO
         Dark slate background, amber accent. Sets the tone immediately.
    ====================================================================== -->
    <section class="bg-slate-900 px-6 py-24 md:py-36">
      <div class="max-w-4xl mx-auto">

        <p class="text-amber-400 text-sm uppercase tracking-[0.25em] font-bold mb-6">
          Independent - One Person, No Agency
        </p>

        <h1 class="text-5xl md:text-7xl font-black uppercase tracking-tighter text-white leading-none mb-8">
          Your IT &amp; Web Guy<br />
          <span class="text-amber-400">Not a vendor</span>
        </h1>

        <p class="text-slate-400 text-lg md:text-xl max-w-xl leading-relaxed mb-12">
          <!-- FLAG: pitch/hook needs more thought - not landing cleanly yet -->
          Websites, networking, devices - if it plugs in or goes online,
          I can handle it. One person, local. Every project is handed off with your code, your logins, and everything you need - whether you continue with me or not.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <!--
            client:load tells Astro to hydrate this React component in the browser.
            Without it, OrderModal would render as static HTML and the button wouldn't work.
            This is what "React island" means - one interactive component in a static page.
          -->
          <OrderModal client:load />
        </div>

      </div>
    </section>

    <!-- =====================================================================
         SERVICES
         Light section - creates contrast rhythm with the dark hero above.
    ====================================================================== -->
    <section class="bg-white px-6 py-20">
      <div class="max-w-5xl mx-auto">

        <p class="text-xs uppercase tracking-[0.25em] font-bold text-slate-400 mb-2">What I do</p>
        <h2 class="text-4xl font-black uppercase tracking-tighter text-slate-900 mb-4">Services</h2>
        <p class="text-slate-500 text-lg max-w-2xl mb-12">
          One person who builds the whole thing - the site, the admin behind it, the contracts
          underneath it, and the machines it all runs on. Nothing gets subcontracted and nothing
          gets handed to a page builder.
        </p>

        {/*
          Static data evaluated at build time - no hooks, no re-renders. The
          icon is raw markup rather than a component so the whole set stays
          editable in one place; Fragment set:html injects it into the shared
          <svg> wrapper below, which keeps stroke weight consistent.
        */}
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {[
            {
              tag: 'Build',
              title: 'Website Design & Build',
              desc: 'Custom sites written in code - fast, mobile-first, and shaped to your business. No WordPress, no Squarespace, no template everyone else is using.',
              icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
            },
            {
              tag: 'Handoff',
              title: 'An Admin You Can Actually Use',
              desc: 'A control panel built for the person who will really be updating the site. Add a job, change a photo, publish - no code, no git, no calling me to change a phone number.',
              icon: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
            },
            {
              tag: 'On-chain',
              title: 'Smart Contracts',
              desc: 'Solidity, written and deployed upgradeable from day one. Escrow, marketplaces, tokens, and staking - audited by the only reviewer that matters, which is anyone who reads the chain.',
              icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/>',
            },
            {
              tag: 'Exchange',
              title: 'Selling Through Homestead',
              desc: 'Getting your goods or your work listed on the exchange and moving. Your price, your customers, direct - no distributor between you and the person buying.',
              icon: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0l-7.2-7.2A2 2 0 0 1 3 12V4a1 1 0 0 1 1-1h8a2 2 0 0 1 1.4.6l7.2 7.2a2 2 0 0 1 0 2.6Z"/><circle cx="7.5" cy="7.5" r="1.5"/>',
            },
            {
              tag: 'Ongoing',
              title: 'Maintenance & Updates',
              desc: 'Content changes, dependency and security patching, uptime and performance monitoring. You do the work you are good at, I keep the thing running.',
              icon: '<path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 3v6h-6"/>',
            },
            {
              tag: 'Hands-on',
              title: 'IT, Networking & Devices',
              desc: 'Wi-Fi that reaches the back of the shop, a printer that will not talk, a machine that needs setting up. On-site or remote, whichever gets it fixed sooner.',
              icon: '<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/>',
            },
          ].map(service => (
            <div class="group border border-slate-100 bg-slate-50 rounded-xl shadow-md p-8 transition-all duration-200 hover:-translate-y-1 hover:shadow-xl hover:border-amber-200">
              <div class="flex items-center justify-between mb-5">
                <svg
                  width="26" height="26" viewBox="0 0 24 24" fill="none"
                  stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                  class="text-amber-500 shrink-0"
                >
                  <Fragment set:html={service.icon} />
                </svg>
                <span class="text-[10px] uppercase tracking-widest font-bold text-slate-400 group-hover:text-amber-600 transition-colors">
                  {service.tag}
                </span>
              </div>
              <h3 class="text-lg font-black uppercase tracking-tight text-slate-900 mb-3 leading-tight">
                {service.title}
              </h3>
              <p class="text-slate-500 text-sm leading-relaxed">
                {service.desc}
              </p>
            </div>
          ))}
        </div>

        <div class="mt-8 border-l-4 border-amber-400 bg-slate-50 px-6 py-5">
          <p class="text-sm font-black uppercase tracking-widest text-slate-900 mb-1">Whatever you take</p>
          <p class="text-slate-500 text-sm leading-relaxed">
            It gets handed off with your code, your logins, your domain, and your accounts in your
            name. If you stop working with me, everything keeps running and you owe nobody permission
            to touch it.
          </p>
        </div>

      </div>
    </section>

    <!-- =====================================================================
         WORK
         Dark section again - alternating rhythm.
    ====================================================================== -->
    <section id="work" class="bg-slate-900 px-6 py-20 scroll-mt-4">
      <div class="max-w-4xl mx-auto">

        <p class="text-xs uppercase tracking-[0.25em] font-bold text-slate-500 mb-2">Case studies</p>
        <h2 class="text-4xl font-black uppercase tracking-tighter text-white mb-12">Work</h2>

        <div class="space-y-6">

          <!-- ArcWright -->
          <div class="border border-slate-800 bg-slate-800/50 p-8 flex flex-col md:flex-row md:items-start gap-8">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs uppercase tracking-widest font-bold text-amber-400">Site Build</span>
                <span class="text-slate-600 text-xs">·</span>
                <span class="text-xs uppercase tracking-widest font-bold text-slate-500">2026</span>
              </div>
              <h3 class="text-xl font-black uppercase tracking-tight text-white mb-2">ArcWright Welding</h3>
              <p class="text-slate-400 text-sm leading-relaxed max-w-lg mb-3">
                Brand identity, site design, and build for a Jacksonville structural welding and fabrication company.
                Fast-loading, mobile-first, with a built-in inquiry form and a custom animated logo.
              </p>
              <div class="flex items-center gap-2 text-white text-xs font-bold uppercase tracking-widest">
                <span>React</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400 shrink-0"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                <span>Vite</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400 shrink-0"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                <span>Tailwind</span>
              </div>
              <a
                href="https://arcwrightwelding.com"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block mt-4 border border-slate-700 hover:border-amber-400 text-slate-400 hover:text-amber-400 text-xs font-bold uppercase tracking-widest px-6 py-3 transition-colors"
              >
                View Site →
              </a>
            </div>

            <div class="w-full md:w-80 shrink-0">
              <ProjectGallery
                client:load
                label="ArcWright Welding"
                shots={[
                  { src: '/work/arcwright-home.webp',      alt: 'Home page - animated scorpion logo' },
                  { src: '/work/arcwright-portfolio.webp', alt: 'Portfolio - filterable project grid' },
                ]}
              />
            </div>
          </div>

          <!-- Homestead -->
          <div class="border border-slate-800 bg-slate-800/50 p-8 flex flex-col md:flex-row md:items-start gap-8">
            <div class="flex-1">
              <div class="flex items-center gap-3 mb-3">
                <span class="text-xs uppercase tracking-widest font-bold text-amber-400">Full-Stack Product</span>
                <span class="text-slate-600 text-xs">·</span>
                <span class="text-xs uppercase tracking-widest font-bold text-slate-500">2025 – Present</span>
              </div>
              <h3 class="text-xl font-black uppercase tracking-tight text-white mb-2">Homestead</h3>
              <p class="text-slate-400 text-sm leading-relaxed max-w-lg mb-3">
                A complete software platform built from scratch - marketplace, payments, smart contracts,
                and a mobile app. Designed and built solo, end to end.
              </p>
              <div class="flex items-center gap-2 text-white text-xs font-bold uppercase tracking-widest">
                <span>Solidity</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400 shrink-0"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                <span>React</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400 shrink-0"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                <span>Node</span>
              </div>
              <a
                href="https://homesteaders.netlify.app"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block mt-4 border border-slate-700 hover:border-amber-400 text-slate-400 hover:text-amber-400 text-xs font-bold uppercase tracking-widest px-6 py-3 transition-colors"
              >
                View Site →
              </a>
            </div>

            <div class="w-full md:w-80 shrink-0">
              <ProjectGallery
                client:load
                label="Homestead"
                shots={[
                  { src: '/work/homestead-home.webp',   alt: 'Storefront - grown here, sold here' },
                  { src: '/work/homestead-market.webp', alt: 'Market - live listings priced in production tokens' },
                ]}
              />
            </div>
          </div>

          <!-- Homestead Mini - forked off Homestead, shown as a child in the tree -->
          <div class="relative ml-6 md:ml-12 pl-6 md:pl-8 border-l-2 border-slate-700">
            <span class="absolute -left-[7px] top-9 w-3 h-3 rounded-full bg-slate-700 border-2 border-slate-900"></span>
            <div class="border border-slate-800 bg-slate-800/30 p-8 flex flex-col md:flex-row md:items-start gap-8">
              <div class="flex-1">
                <div class="flex items-center gap-3 mb-3">
                  <span class="text-xs uppercase tracking-widest font-bold text-amber-400/70">Fork · Landing Site</span>
                  <span class="text-slate-600 text-xs">·</span>
                  <span class="text-xs uppercase tracking-widest font-bold text-slate-500">2026</span>
                </div>
                <h4 class="text-xl font-black uppercase tracking-tight text-white mb-2">Homestead Mini</h4>
                <p class="text-slate-400 text-sm leading-relaxed max-w-lg mb-3">
                  Scoped-down fork of Homestead - a lightweight local barter exchange landing site for a single trade community.
                </p>
                <div class="flex items-center gap-2 text-white text-xs font-bold uppercase tracking-widest">
                  <span>Astro</span>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-400 shrink-0"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                  <span>Tailwind</span>
                </div>
                <a
                  href="https://homestead-mini.netlify.app"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-block mt-4 border border-slate-700 hover:border-amber-400 text-slate-400 hover:text-amber-400 text-xs font-bold uppercase tracking-widest px-6 py-3 transition-colors"
                >
                  View Site →
                </a>
              </div>

              <div class="w-full md:w-72 shrink-0">
                <ProjectGallery
                  client:load
                  label="Homestead Mini"
                  shots={[
                    { src: '/work/homestead-mini-home.webp',  alt: 'Landing page - trade what you have' },
                    { src: '/work/homestead-mini-offer.webp', alt: 'What is on offer and what is needed' },
                  ]}
                />
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =====================================================================
         THE ARRANGEMENT
         No invoice. The build is free; the platform fee on sales is the
         compensation, and it is stated up front rather than hoped for.
    ====================================================================== -->
    <section class="bg-white px-6 py-20 border-t border-slate-100">
      <div class="max-w-4xl mx-auto">

        <p class="text-xs uppercase tracking-[0.25em] font-bold text-slate-400 mb-2">The arrangement</p>
        <h2 class="text-4xl font-black uppercase tracking-tighter text-slate-900 mb-4">I don't charge you</h2>
        <p class="text-slate-500 text-lg max-w-xl mb-12">
          No invoice, no retainer, no hourly rate. I build it, and you sell through Homestead -
          the exchange I built for people who make things. That's the whole trade.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {[
            {
              step: '01',
              title: 'You pay me nothing',
              desc: 'The site, the setup, the handoff. No bill arrives - not up front, not on delivery, not monthly.',
            },
            {
              step: '02',
              title: 'You sell through Homestead',
              desc: 'Your goods get listed on the exchange - your price, your customers, direct. Listing means posting a pledge: ETH held by the Treasury contract, never spent and never mine, returned to you as your orders are delivered. It is what lets a stranger trust you without knowing you.',
            },
            {
              step: '03',
              title: 'The platform takes a fee',
              desc: 'A small fee applies to each sale, set by the Treasury contract and visible on-chain. That fee is how I get paid - not by you, by the volume you help create.',
            },
          ].map(item => (
            <div class="bg-slate-50 border border-slate-200 rounded-xl shadow-md p-8">
              <span class="text-4xl font-black text-amber-400 block mb-4">{item.step}</span>
              <h3 class="text-base font-black uppercase tracking-tight text-slate-900 mb-3">{item.title}</h3>
              <p class="text-slate-500 text-sm leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>

        <div class="mt-8 border border-amber-200 bg-amber-50 px-6 py-5">
          <p class="text-sm font-black uppercase tracking-widest text-amber-700 mb-1">Why it works this way</p>
          <p class="text-slate-500 text-sm leading-relaxed">
            A platform is worth nothing empty. I'd rather carry the build cost and have you actually
            trading on it than send you an invoice and watch the thing sit unused. If you never sell
            anything, I never earn anything - so we both have something in it. I carry the build,
            you carry the pledge, and neither of us gets paid until something real changes hands.
          </p>
        </div>

      </div>
    </section>

  </main>

  <!-- =====================================================================
       FOOTER
       Thin bar - just attribution, no CTA.
  ====================================================================== -->
  <!--
    Pinned to the viewport, so z-index matters: the lightbox overlay sits at
    z-50 and must stay above this. <main> carries matching bottom padding so
    the last section is not hidden underneath.
  -->
  <footer class="fixed bottom-0 inset-x-0 z-40 bg-slate-900 border-t-4 border-amber-400 px-6 py-4">
    <div class="max-w-4xl mx-auto flex items-center justify-center">
      <p class="text-xs uppercase tracking-[0.2em] font-bold text-white">
        © {new Date().getFullYear()} Justin
      </p>
    </div>
  </footer>

</Layout>
